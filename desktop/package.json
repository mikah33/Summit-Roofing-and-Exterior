{
  "name": "summit-roofing-desktop",
  "version": "1.0.0",
  "description": "Summit Roofing & Exterior desktop app",
  "author": "Summit Roofing & Exterior",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "work.summitroofing.desktop",
    "productName": "Summit Roofing & Exterior",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Summit Roofing"
    },
    "portable": {
      "artifactName": "Summit-Roofing-Portable.exe"
    }
  }
}
